# SQL Server uses SQL authentication; the account needs SELECT on source tables.
DEV_SQLSERVER_HOST=host
DEV_SQLSERVER_PORT=1433
DEV_SQLSERVER_DATABASE=DBName
DEV_SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
# Dev server uses a self-signed certificate; do not do this in production.
DEV_SQLSERVER_TRUST_CERTIFICATE=yes
DEV_SQLSERVER_USER=user
DEV_SQLSERVER_PASSWORD=ps

AI_POSTGRES_URL=postgresql://postgres:xx@xx:5432/xx
