# Example values. Use secrets management in deployed environments.
# SQL Server uses SQL authentication; the account needs SELECT on source tables.
DEV_SQLSERVER_HOST=sqlserver.example.internal
DEV_SQLSERVER_PORT=1433
DEV_SQLSERVER_DATABASE=DevDatabase
DEV_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# Do not bypass server certificate validation in production.
DEV_SQLSERVER_TRUST_CERTIFICATE=no
DEV_SQLSERVER_USER=REPLACE_ME
DEV_SQLSERVER_PASSWORD=REPLACE_ME

# An independent PostgreSQL user with limited access to ETL schemas.
AI_POSTGRES_URL=postgresql+psycopg://ai_etl:REPLACE_ME@localhost:5432/ai_database
